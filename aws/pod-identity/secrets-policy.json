{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadBoutiqueRDSManagedSecret",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret",
        "secretsmanager:ListSecretVersionIds"
      ],
      "Resource": "arn:aws:secretsmanager:us-east-1:663130434910:secret:rds!db-7e157237-f45d-49ca-b15e-69564c0a712c-nDs6Xi"
    },
    {
      "Sid": "CustomerManagedKMSViaSecretsManager",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:DescribeKey"
      ],
      "Resource": "arn:aws:kms:us-east-1:663130434910:key/*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "secretsmanager.us-east-1.amazonaws.com"
        }
      }
    }
  ]
}
